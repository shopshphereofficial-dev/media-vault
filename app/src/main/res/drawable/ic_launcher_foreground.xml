    android:viewportHeight="108">
    <!-- Vault Hexagonal Shield Base -->
    <path
        android:pathData="M54,26 L76,37 L76,60 C76,73 66,82 54,86 C42,82 32,73 32,60 L32,37 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="32"
                android:startY="26"
                android:endX="76"
                android:endY="86">
                <item android:color="#1E293B" android:offset="0.0" />
                <item android:color="#0F172A" android:offset="1.0" />
